#!/usr/bin/env python3
"""
AsenaDPI — system tray + ayar penceresi.
- SOL TIK: ayar penceresi (Qt cizer, tiklayinca kapanmaz -> toplu degisiklik).
  (Wayland/SNI'de tray menusunu host cizer, tikta kapanir; ayarlar bu yuzden pencerede.)
- SAG TIK: hizli menu (Baglan/kes, Ayarlar, En iyiyi bul, Log, DNS onar, Cikis).
- Mod (Blacklist/Full), HTTP/3 (Bypass/Kapali/Engelle), Gelismis (HTTP/HTTP2),
  "Degisecekler" onizleme, Uygula. nfqws desync + DoT + fail-safe.
"""
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

from PySide6.QtWidgets import (
    QApplication, QSystemTrayIcon, QMenu, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QRadioButton, QCheckBox, QPushButton, QButtonGroup, QFrame, QPlainTextEdit,
)
from PySide6.QtGui import QIcon, QAction, QPainter, QColor, QBrush, QPen, QPixmap, QPainterPath, QFont, QTextCursor
from PySide6.QtCore import QTimer, Qt, QPointF, QProcess

ON = ["sudo", "-n", "/usr/local/bin/asena-dpi-on"]
OFF = ["sudo", "-n", "/usr/local/bin/asena-dpi-off"]
OPTIMIZE = ["sudo", "-n", "/usr/local/bin/asena-dpi-optimize"]
UPDATE = ["sudo", "-n", "/usr/local/bin/asena-dpi-update"]
LOG = "/var/log/asena-dpi.log"
CFG = Path.home() / ".config" / "asena-dpi"
REPO_FILE = CFG / "repo_dir"
LAST_UPDATE_CHECK = CFG / "last_update_check"
BLACKLIST = str(CFG / "blacklist.txt")
SETTINGS = CFG / "settings.conf"

DEFAULTS = {"MODE": "blacklist", "HTTP": "1", "HTTP2": "1", "HTTP3": "bypass"}
LBL = {
    "MODE": ("Mod", {"blacklist": "Blacklist", "full": "Full"}),
    "HTTP": ("HTTP (80)", {"1": "açık", "0": "kapalı"}),
    "HTTP2": ("HTTP/2 (443)", {"1": "açık", "0": "kapalı"}),
    "HTTP3": ("HTTP/3·QUIC", {"bypass": "Bypass", "off": "Kapalı", "block": "Engelle"}),
}
ACCENT = "#26A69A"


def load_settings() -> dict:
    s = dict(DEFAULTS)
    try:
        for line in SETTINGS.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k = k.strip(); v = v.strip().strip('"').strip("'")
            if k in DEFAULTS:
                s[k] = v
    except FileNotFoundError:
        pass
    if s["HTTP3"] == "1": s["HTTP3"] = "bypass"
    elif s["HTTP3"] == "0": s["HTTP3"] = "off"
    return s


def save_settings(s: dict):
    CFG.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(
        "# AsenaDPI ayarlari — tray yazar, asena-dpi-on okur.\n"
        "# MODE: blacklist|full  HTTP/HTTP2: 1|0  HTTP3: bypass|off|block\n"
        f"MODE={s['MODE']}\nHTTP={s['HTTP']}\nHTTP2={s['HTTP2']}\nHTTP3={s['HTTP3']}\n"
    )


def is_on() -> bool:
    return subprocess.run(["pgrep", "-x", "nfqws"], capture_output=True).returncode == 0


def notify(title, body):
    try:
        subprocess.Popen(["notify-send", "-a", "AsenaDPI", "-i", "network-vpn", title, body])
    except Exception:
        pass


def make_icon(on: bool) -> QIcon:
    pm = QPixmap(64, 64); pm.fill(Qt.transparent)
    p = QPainter(pm); p.setRenderHint(QPainter.Antialiasing)
    path = QPainterPath()
    path.moveTo(32, 6); path.lineTo(54, 15); path.lineTo(54, 34)
    path.cubicTo(54, 48, 44, 55, 32, 60); path.cubicTo(20, 55, 10, 48, 10, 34)
    path.lineTo(10, 15); path.closeSubpath()
    if on:
        p.setBrush(QBrush(QColor(38, 166, 154))); p.setPen(QPen(QColor(19, 111, 99), 2)); p.drawPath(path)
        p.setPen(QPen(QColor(255, 255, 255), 6, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
        p.drawPolyline([QPointF(23, 33), QPointF(30, 41), QPointF(43, 24)])
    else:
        p.setBrush(QBrush(QColor(70, 70, 74))); p.setPen(QPen(QColor(120, 120, 126), 2)); p.drawPath(path)
    p.end()
    return QIcon(pm)


def hline():
    f = QFrame(); f.setFrameShape(QFrame.HLine); f.setStyleSheet("color:#2a2f37;")
    return f


def desc(text):
    l = QLabel(text); l.setWordWrap(True); l.setStyleSheet("color:#8a929c; font-size:11px;")
    return l


def section(text):
    l = QLabel(text); f = QFont(); f.setBold(True); f.setPointSize(10); l.setFont(f)
    l.setStyleSheet(f"color:{ACCENT}; margin-top:4px;")
    return l


class SettingsWindow(QWidget):
    def __init__(self, tray):
        super().__init__()
        self.tray = tray
        self._busy = False
        self.saved = load_settings()
        self.pending = dict(self.saved)
        self.setWindowTitle("AsenaDPI — Ayarlar")
        self.setMinimumWidth(450)
        self.setWindowIcon(make_icon(True))
        self.setStyleSheet(f"""
            QWidget {{ background:#1b1f27; color:#e6e9ee; font-size:12px; }}
            QRadioButton, QCheckBox {{ padding:3px 0; }}
            QPushButton {{ background:#2a2f37; border:1px solid #3a414c; border-radius:6px; padding:7px 14px; }}
            QPushButton:hover {{ background:#333a44; }}
            QPushButton#apply {{ background:{ACCENT}; border:none; color:#04201c; font-weight:bold; }}
            QPushButton#apply:disabled {{ background:#2a2f37; color:#5b636e; }}
        """)
        root = QVBoxLayout(self); root.setContentsMargins(16, 16, 16, 16); root.setSpacing(9)

        top = QHBoxLayout()
        self.status = QLabel(); self.status.setStyleSheet("font-size:13px; font-weight:bold;")
        self.btn_power = QPushButton("Bağlan"); self.btn_power.clicked.connect(self.toggle_power)
        top.addWidget(self.status); top.addStretch(1); top.addWidget(self.btn_power)
        root.addLayout(top); root.addWidget(hline())

        root.addWidget(section("Mod"))
        self.g_mode = QButtonGroup(self)
        self.rb_bl = QRadioButton("Blacklist  —  yalnız listedeki siteler")
        self.rb_full = QRadioButton("Full  —  tüm trafik")
        for rb, v in ((self.rb_bl, "blacklist"), (self.rb_full, "full")):
            self.g_mode.addButton(rb); rb.toggled.connect(lambda c, val=v: c and self.set_pending("MODE", val))
            root.addWidget(rb)
        root.addWidget(hline())

        root.addWidget(section("HTTP/3 · QUIC"))
        self.g_h3 = QButtonGroup(self)
        self.rb_h3_bypass = QRadioButton("Bypass  —  DPI'dan geçirmeye çalış")
        self.rb_h3_off = QRadioButton("Kapalı  —  dokunma")
        self.rb_h3_block = QRadioButton("Engelle  —  QUIC kes → TCP'ye düş  (eduroam/oyun)")
        for rb, v in ((self.rb_h3_bypass, "bypass"), (self.rb_h3_off, "off"), (self.rb_h3_block, "block")):
            self.g_h3.addButton(rb); rb.toggled.connect(lambda c, val=v: c and self.set_pending("HTTP3", val))
            root.addWidget(rb)
        root.addWidget(hline())

        root.addWidget(section("Gelişmiş"))
        self.cb_http = QCheckBox("HTTP (80)")
        self.cb_http.toggled.connect(lambda c: self.set_pending("HTTP", "1" if c else "0"))
        self.cb_http2 = QCheckBox("HTTP/2 (443) — Discord/web, kapatma")
        self.cb_http2.toggled.connect(lambda c: self.set_pending("HTTP2", "1" if c else "0"))
        root.addWidget(self.cb_http); root.addWidget(self.cb_http2)
        root.addWidget(hline())

        root.addWidget(section("Değişecekler"))
        self.diff = QLabel("Değişiklik yok"); self.diff.setWordWrap(True)
        self.diff.setStyleSheet("color:#c7ccd4; font-size:11px; background:#181c23; "
                                "border:1px solid #262c36; border-radius:8px; padding:8px;")
        root.addWidget(self.diff)

        btns = QHBoxLayout()
        b_edit = QPushButton("Blacklist…"); b_edit.clicked.connect(lambda: subprocess.Popen(["xdg-open", BLACKLIST]))
        b_opt = QPushButton("En iyiyi bul"); b_opt.clicked.connect(self.optimize)
        btns.addWidget(b_edit); btns.addWidget(b_opt); btns.addStretch(1)
        self.btn_apply = QPushButton("⟳ Uygula"); self.btn_apply.setObjectName("apply")
        self.btn_apply.clicked.connect(self.apply_changes)
        b_close = QPushButton("Kapat"); b_close.clicked.connect(self.hide)
        btns.addWidget(self.btn_apply); btns.addWidget(b_close)
        root.addLayout(btns)

        self.sync_from_pending(); self.refresh_status()
        self.tmr = QTimer(self); self.tmr.timeout.connect(self.refresh_status); self.tmr.start(2500)

    def refresh_status(self):
        on = is_on()
        self.status.setText("🟢  AsenaDPI AÇIK" if on else "⚪  AsenaDPI kapalı")
        self.status.setStyleSheet(f"font-size:13px; font-weight:bold; color:{'#3ddc97' if on else '#8a929c'};")
        self.btn_power.setText("Kapat" if on else "Bağlan")

    def toggle_power(self):
        if self._busy:
            return
        self._busy = True
        if is_on():
            subprocess.run(OFF, capture_output=True, timeout=25); notify("AsenaDPI kapatıldı", "DNS geri alındı")
        else:
            save_settings(self.pending); self.saved = dict(self.pending)
            subprocess.run(ON, capture_output=True, timeout=25); notify("AsenaDPI bağlandı", self._summary(self.saved))
        self._busy = False
        QTimer.singleShot(400, self.refresh_status); QTimer.singleShot(400, self.tray.refresh)
        QTimer.singleShot(450, self.update_diff)

    def optimize(self):
        self.tray.optimize()   # tray'in canli konsollu popup'ini ac

    def set_pending(self, key, val):
        self.pending[key] = val; self.update_diff()

    def sync_from_pending(self):
        p = self.pending
        self.rb_bl.setChecked(p["MODE"] != "full"); self.rb_full.setChecked(p["MODE"] == "full")
        self.rb_h3_bypass.setChecked(p["HTTP3"] == "bypass"); self.rb_h3_off.setChecked(p["HTTP3"] == "off")
        self.rb_h3_block.setChecked(p["HTTP3"] == "block")
        self.cb_http.setChecked(p["HTTP"] == "1"); self.cb_http2.setChecked(p["HTTP2"] == "1")
        self.update_diff()

    def _summary(self, s):
        parts = [LBL["MODE"][1][s["MODE"]], "QUIC:" + LBL["HTTP3"][1][s["HTTP3"]]]
        if s["HTTP"] == "0": parts.append("HTTP✗")
        if s["HTTP2"] == "0": parts.append("HTTP2✗")
        return " · ".join(parts)

    def update_diff(self):
        rows = []
        for k in ("MODE", "HTTP3", "HTTP", "HTTP2"):
            if self.pending[k] != self.saved[k]:
                name, vmap = LBL[k]
                rows.append(f"• {name}:  {vmap[self.saved[k]]}  →  <b style='color:{ACCENT}'>{vmap[self.pending[k]]}</b>")
        dirty = bool(rows)
        self.diff.setText("<br>".join(rows) if dirty else "Değişiklik yok")
        self.btn_apply.setEnabled(dirty)

    def apply_changes(self):
        if self._busy or self.pending == self.saved:
            return
        self._busy = True
        save_settings(self.pending); self.saved = dict(self.pending)
        if is_on():
            subprocess.run(OFF, capture_output=True, timeout=25)
            subprocess.run(ON, capture_output=True, timeout=25)
            notify("AsenaDPI güncellendi", self._summary(self.saved))
        self._busy = False
        self.update_diff(); QTimer.singleShot(400, self.refresh_status); QTimer.singleShot(400, self.tray.refresh)

    def open_fresh(self):
        self.saved = load_settings(); self.pending = dict(self.saved)
        self.sync_from_pending(); self.refresh_status()
        self.show(); self.raise_(); self.activateWindow()


class OptimizeWindow(QWidget):
    """blockcheck'i (asena-dpi-optimize) CANLI konsolla calistiran kucuk popup —
    arka planda gorunmez calismasin, kullanici ne oldugunu gorsun."""
    def __init__(self, tray):
        super().__init__()
        self.tray = tray
        self.proc = None
        self._on_done = None
        self.setWindowTitle("AsenaDPI — En iyi strateji (blockcheck)")
        self.resize(600, 400)
        self.setWindowIcon(make_icon(True))
        self.setStyleSheet(f"""
            QWidget {{ background:#1b1f27; color:#e6e9ee; font-size:12px; }}
            QPushButton {{ background:#2a2f37; border:1px solid #3a414c; border-radius:6px; padding:6px 14px; }}
            QPushButton:hover {{ background:#333a44; }}
            QPushButton:disabled {{ color:#5b636e; }}
        """)
        v = QVBoxLayout(self); v.setContentsMargins(14, 14, 14, 14); v.setSpacing(8)
        self.status = QLabel("blockcheck çalışıyor… (birkaç dakika sürebilir)")
        self.status.setStyleSheet("font-weight:bold;")
        v.addWidget(self.status)
        self.out = QPlainTextEdit(); self.out.setReadOnly(True)
        self.out.setStyleSheet("background:#0e1116; color:#b8e0d2; border:1px solid #262c36; "
                               "border-radius:6px; font-family:monospace; font-size:11px;")
        v.addWidget(self.out)
        h = QHBoxLayout(); h.addStretch(1)
        self.btn_stop = QPushButton("Durdur"); self.btn_stop.clicked.connect(self.stop)
        self.btn_close = QPushButton("Kapat"); self.btn_close.clicked.connect(self.close)
        h.addWidget(self.btn_stop); h.addWidget(self.btn_close)
        v.addLayout(h)

    def run(self, cmd=None, title="blockcheck çalışıyor… (birkaç dakika · pencereyi açık tutabilirsin)",
            on_done=None, window_title="AsenaDPI — En iyi strateji (blockcheck)"):
        if cmd is None:
            cmd = OPTIMIZE
        if self.proc and self.proc.state() != QProcess.NotRunning:
            self.show(); self.raise_(); self.activateWindow(); return
        self._on_done = on_done
        self.setWindowTitle(window_title)
        self.out.clear()
        self.status.setText(title)
        self.btn_stop.setEnabled(True)
        self.show(); self.raise_(); self.activateWindow()
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.MergedChannels)
        self.proc.readyRead.connect(self._read)
        self.proc.finished.connect(self._done)
        self.proc.start(cmd[0], cmd[1:])

    def _read(self):
        data = bytes(self.proc.readAll()).decode("utf-8", "replace")
        self.out.moveCursor(QTextCursor.End)
        self.out.insertPlainText(data)
        self.out.moveCursor(QTextCursor.End)

    def _done(self, code, _st):
        self.btn_stop.setEnabled(False)
        if self._on_done:
            cb = self._on_done; self._on_done = None
            cb(code); self.tray.refresh(); return
        if code == 0:
            self.status.setText("✅ En iyi strateji bulundu ve uygulandı.")
        elif code == 2:
            self.status.setText("ℹ️ Bu ağda DPI stratejisi gerekmedi (DNS/DoT yeterli).")
        else:
            self.status.setText(f"Bitti (çıkış kodu {code}).")
        self.tray.refresh()

    def stop(self):
        if self.proc and self.proc.state() != QProcess.NotRunning:
            self.proc.terminate()   # SIGTERM -> blockcheck kendi nft'sini temizler
            self.status.setText("Durduruldu.")
            self.btn_stop.setEnabled(False)

    def closeEvent(self, e):
        # kapatinca calisiyorsa nazikce durdur (blockcheck cleanup yapsin)
        if self.proc and self.proc.state() != QProcess.NotRunning:
            self.proc.terminate()
        e.accept()


class AsenaTray:
    def __init__(self, app):
        self.app = app
        self.icon_on = make_icon(True); self.icon_off = make_icon(False)
        self.win = None
        self.optwin = None
        self.tray = QSystemTrayIcon()
        self.menu = QMenu()
        self.act_toggle = QAction("Bağlan", self.menu); self.act_toggle.triggered.connect(self.toggle)
        self.menu.addAction(self.act_toggle)
        a_set = QAction("Ayarlar…", self.menu); a_set.triggered.connect(self.open_settings)
        self.menu.addAction(a_set)
        a_opt = QAction("En iyi stratejiyi bul", self.menu); a_opt.triggered.connect(self.optimize)
        self.menu.addAction(a_opt)
        self.menu.addSeparator()
        a_log = QAction("Logu göster", self.menu)
        a_log.triggered.connect(lambda: subprocess.Popen(["xdg-open", LOG]) if Path(LOG).exists() else None)
        self.menu.addAction(a_log)
        a_fix = QAction("DNS'i onar", self.menu); a_fix.triggered.connect(self.repair)
        self.menu.addAction(a_fix)
        self.act_update = QAction("Güncelle (GitHub)", self.menu); self.act_update.triggered.connect(self.update)
        self.menu.addAction(self.act_update)
        self.menu.addSeparator()
        a_q = QAction("Çıkış", self.menu); a_q.triggered.connect(app.quit)
        self.menu.addAction(a_q)
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self.on_act)
        self.tray.show()
        self.t = QTimer(); self.t.timeout.connect(self.refresh); self.t.start(3000)
        self.refresh()
        QTimer.singleShot(8000, self._autocheck)   # acilistan sonra sessiz guncelleme denetimi

    def open_settings(self):
        if self.win is None:
            self.win = SettingsWindow(self)
        self.win.open_fresh()

    def optimize(self):
        # canli konsollu popup (arka planda gorunmez calismasin)
        if self.optwin is None:
            self.optwin = OptimizeWindow(self)
        self.optwin.run()

    def on_act(self, reason):
        if reason == QSystemTrayIcon.Trigger:
            self.toggle()   # sol tik = ac/kapat (ayarlar sag tik menusunde)

    def toggle(self):
        if is_on():
            subprocess.run(OFF, capture_output=True, timeout=25); notify("AsenaDPI kapatıldı", "DNS geri alındı")
        else:
            subprocess.run(ON, capture_output=True, timeout=25); notify("AsenaDPI bağlandı", "")
        QTimer.singleShot(500, self.refresh)

    def repair(self):
        subprocess.run(ON, capture_output=True, timeout=25)
        QTimer.singleShot(500, self.refresh)

    def update(self):
        if self.optwin is None:
            self.optwin = OptimizeWindow(self)

        def done(code):
            if code == 0:
                self.optwin.status.setText("✅ Güncellendi. Tray yeniden başlatılıyor…")
                QTimer.singleShot(1400, self._restart)
            else:
                self.optwin.status.setText(f"Güncelleme başarısız (çıkış kodu {code}). Log'a bak.")
        self.optwin.run(UPDATE, "Güncelleniyor (git pull + yeniden kur)…", done, "AsenaDPI — Güncelle")

    def _restart(self):
        # tray'i yeni koddan yeniden calistir
        try:
            os.execv(sys.executable, [sys.executable] + sys.argv)
        except Exception:
            self.app.quit()

    def _autocheck(self):
        threading.Thread(target=self._do_autocheck, daemon=True).start()

    def _do_autocheck(self):
        try:
            repo = REPO_FILE.read_text(encoding="utf-8").strip()
            if not repo or not os.path.isdir(os.path.join(repo, ".git")):
                return
            try:
                if time.time() - float(LAST_UPDATE_CHECK.read_text(encoding="utf-8")) < 21600:
                    return   # 6 saatte bir
            except (OSError, ValueError):
                pass
            subprocess.run(["git", "-C", repo, "fetch", "--quiet"], capture_output=True, timeout=30)
            r = subprocess.run(["git", "-C", repo, "rev-list", "--count", "HEAD..@{u}"],
                               capture_output=True, text=True, timeout=10)
            try:
                LAST_UPDATE_CHECK.write_text(str(time.time()), encoding="utf-8")
            except OSError:
                pass
            n = (r.stdout or "0").strip()
            if n.isdigit() and int(n) > 0:
                notify("AsenaDPI güncelleme", f"{n} yeni sürüm — sağ tık → Güncelle")
        except Exception:
            pass

    def refresh(self):
        on = is_on()
        self.tray.setIcon(self.icon_on if on else self.icon_off)
        self.act_toggle.setText("Bağlantıyı kes" if on else "Bağlan")
        mode = load_settings()["MODE"]
        self.tray.setToolTip(f"AsenaDPI: {'AÇIK · ' + mode if on else 'kapalı'}  (sol tık: aç/kapat)")


def main():
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    app.setApplicationName("AsenaDPI")
    _t = AsenaTray(app)
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
